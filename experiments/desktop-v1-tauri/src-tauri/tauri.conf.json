{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MedOrigin Synthetic Desktop v1",
  "version": "0.0.0",
  "identifier": "com.medorigin.desktop.v1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "MedOrigin — Synthetic Developer Preview (v1)",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; worker-src 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
