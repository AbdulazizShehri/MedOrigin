{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MedOrigin Synthetic Developer Preview",
  "version": "0.0.0",
  "identifier": "com.medorigin.desktop.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MedOrigin — Synthetic Developer Preview",
        "width": 1040,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
